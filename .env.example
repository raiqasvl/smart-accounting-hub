# Copy to `.env` and fill in. `.env` is gitignored.
#
# Local dev only at MVP. Production-only env vars (Sentry, restic backups, B2 credentials)
# are deferred — see plan §0 (D17/D18/D19/D20 marked deferred to post-MVP).

# --- core ---
DOMAIN=                              # cloudflared tunnel hostname WITHOUT https://, e.g. budget-safe-buck-viewers.trycloudflare.com
ENVIRONMENT=development
DEBUG=True

# --- telegram ---
BOT_TOKEN=                           # from @BotFather. See docs/bot-setup.md.
BOT_USERNAME=                        # without @, used to construct deep-link invite URLs

# --- jwt (Mini-App auth, D12) ---
JWT_SECRET=                          # 32+ bytes, run: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_LIFETIME_SECONDS=1800            # D12: 30 minutes

# --- postgres ---
# When `apps/api` and `apps/bot` run on the host (default dev workflow), the host name is `localhost`.
# Password must match db/password.txt (consumed by the postgres container as a Docker secret).
POSTGRES_DSN=postgresql+asyncpg://smart_accounting:CHANGEME@localhost:5432/smart_accounting

# --- redis ---
REDIS_DSN=redis://localhost:6379/0

# --- logging ---
LOG_LEVEL=DEBUG

# --- fx providers ---
FRANKFURTER_BASE_URL=https://api.frankfurter.dev/v1
FX_REFRESH_INTERVAL_SECONDS=3600     # 1 hour

# --- mini-app ---
# Resolve ${DOMAIN} to your actual cloudflared subdomain (Next.js doesn't shell-interpolate on read).
NEXT_PUBLIC_API_BASE_URL=https://YOUR-TUNNEL.trycloudflare.com/api/v1
NEXT_PUBLIC_BOT_USERNAME=
