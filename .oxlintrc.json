{
  "$schema": "./node_modules/oxlint/configuration_schema.json",

  "//": "Oxlint config — Rust-native ESLint replacement, ~50× faster. No ESLint at v1.0.",
  "//deny": "Rules graduate from `warn` to `error` as we tighten in M5 security pass.",

  "plugins": ["typescript", "react", "react-perf", "jsx-a11y", "import", "node", "promise", "unicorn", "nextjs"],

  "categories": {
    "correctness": "error",
    "perf": "warn",
    "suspicious": "warn",
    "pedantic": "off",
    "nursery": "off"
  },

  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },

  "globals": {
    "Telegram": "readonly"
  },

  "rules": {
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "no-debugger": "error",
    "import/no-default-export": "off",
    "react/react-in-jsx-scope": "off",
    "react/prop-types": "off",
    "react/jsx-key": "error",
    "react/no-array-index-key": "warn",
    "react-perf/jsx-no-new-object-as-prop": "warn",
    "react-perf/jsx-no-new-array-as-prop": "warn",
    "react-perf/jsx-no-new-function-as-prop": "warn",
    "jsx-a11y/anchor-is-valid": "warn",
    "typescript/no-explicit-any": "warn",
    "typescript/no-unused-vars": ["error", { "argsIgnorePattern": "^_" }],
    "typescript/consistent-type-imports": "error",
    "unicorn/prefer-node-protocol": "error",
    "unicorn/no-array-for-each": "off",
    "unicorn/filename-case": "off",
    "nextjs/no-html-link-for-pages": "off"
  },

  "settings": {
    "next": {
      "rootDir": ["apps/miniapp/"]
    }
  },

  "ignorePatterns": [
    "node_modules",
    ".next",
    ".turbo",
    "dist",
    "build",
    "research",
    "thoughts",
    "packages/api-types/src/api.d.ts",
    "**/*.d.ts"
  ]
}
